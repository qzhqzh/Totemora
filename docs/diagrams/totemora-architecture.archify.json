    {
      "dot": "cyan",
      "title": "依赖方向",
      "items": [
        "Adapter → Gateway / Core；Adapter 不复制领域 Runtime",
        "Server 组合 Application、Domain、Repository 与 Integration",
        "Core 不反向依赖 Server、Web 或外部通道"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态与证据",
      "items": [
        "SQLite 保存可变业务状态与恢复信息",
        "Run trace、Skill 文件和静态资产保持独立证据边界",
        "Secret 与完整设备 key 不进入普通响应或日志"
      ]
    },
    {
      "dot": "amber",
      "title": "扩展原则",
      "items": [
        "新能力优先成为具名领域服务，而不是继续扩大 Server App",
        "Web 保持薄 bootstrap，并按领域 Feature 拆分",
        "外部动作必须经过权限、幂等、审计和显式门禁"
      ]
