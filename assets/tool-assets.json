{
  "schema_version": 1,
  "assets": [
    {
      "id": "git-flow-engine",
      "name": "Git Flow Engine",
      "kind": "tool_service",
      "maturity": "verified",
      "version": 1,
      "summary": "受控执行 Branch、Validation、Commit、Issue、Push、PR Review 和 Squash Merge 的确定性状态机。",
      "executor": "builtin:DevelopmentCommitService",
      "actions": ["plan", "execute_local", "execute_remote", "review_pr", "execute_merge"],
      "risk": "high",
      "default_access": "deny",
      "policy_requirements": ["registered_workplace", "versioned_policy", "operator_gate", "snapshot_match"],
      "blueprint": {
        "source": "docs/adr/0004-development-commit-steward.md",
        "notes": "模型负责结构化判断；程序负责固定命令、状态恢复和安全校验。"
      }
    },
    {
      "id": "opencode-correction",
      "name": "OpenCode Correction Runner",
      "kind": "tool_adapter",
      "maturity": "experimental",
      "version": 1,
      "summary": "验证失败后，在批准文件和命令白名单内启动 OpenCode 的受限修复会话。",
      "executor": "binary:opencode",
      "actions": ["correct_code"],
      "risk": "high",
      "default_access": "deny",
      "policy_requirements": ["allow_opencode_fix", "approved_file_scope", "validation_failure"],
      "blueprint": {
        "source": "https://opencode.ai/docs/agents/",
        "notes": "默认拒绝权限；禁止 --auto、外部目录和 Git 远端操作。尚无真实修复 Run 证据。"
      }
    },
    {
      "id": "news-intelligence",
      "name": "News Intelligence Watch",
      "kind": "tool_service",
      "maturity": "experimental",
      "version": 2,
      "summary": "从 HTTPS 白名单信息源收集热点，经情报员评估和确定性去重进入候选池，再由常驻派发器节流推送到 Bark。",
      "executor": "builtin:IntelligenceService",
      "actions": ["collect", "summarize", "push_bark"],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["https_source_allowlist", "operator_gate", "secret_isolation", "action_journal"],
      "blueprint": {
        "source": "docs/adr/0009-intelligence-candidate-pipeline.md",
        "notes": "默认每 10 分钟扫描；候选需经过价值阈值与重复门禁，外发至少间隔一分钟且必须幂等、可审计。"
      }
    },
    {
      "id": "internal-bark",
      "name": "Internal Bark Notification Channel",
      "kind": "infrastructure",
      "maturity": "experimental",
      "version": 1,
      "summary": "部落自建的 Bark V2 通知通道，使用独立 device key、健康检查、退避熔断和不透明点击回执。",
      "executor": "builtin:BarkNotificationService + container:ghcr.io/finb/bark-server",
      "actions": ["health_check", "push_notification", "record_open_feedback"],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["secret_isolation", "localhost_or_https", "bounded_retry", "circuit_breaker", "opaque_callback"],
      "blueprint": {
        "source": "docs/internal-bark.md",
        "notes": "服务端自建可移除 api.day.app 依赖，但仍依赖 Apple APNs；Bark 接受不等于用户已打开。"
      }
    },
    {
      "id": "aihot-public-feed",
      "name": "AI HOT Public Feed",
      "kind": "tool_adapter",
      "maturity": "experimental",
      "version": 1,
      "summary": "通过 AI HOT 匿名只读 REST API 获取公开精选，以 fingerprint 控制轮询流量，并保留聚合站与原始信源双重归属。",
      "executor": "builtin:IntelligenceService.collectAiHot",
      "actions": ["read_fingerprint", "read_selected"],
      "risk": "low",
      "default_access": "deny",
      "policy_requirements": ["public_read_only", "identifiable_user_agent", "bounded_polling", "attribution_preserved", "original_source_verification"],
      "blueprint": {
        "source": "https://aihot.virxact.com/agent",
        "notes": "每次巡查先读 fingerprint；变化后才拉 selected items。AI 生成摘要只用于发现和排序，数字、政策、引语与安全事件应回原文复核。"
      }
    },
    {
      "id": "zvec",
      "name": "Zvec",
      "kind": "infrastructure",
      "maturity": "candidate",
      "version": 1,
      "summary": "候选的开源进程内向量数据库；当前仅作为资产图纸，不自动安装或调用。",
      "executor": "uninstalled",
      "actions": [],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["evaluation_required"],
      "blueprint": {
        "source": "https://github.com/alibaba/zvec",
        "notes": "需要真实检索任务、资源占用和维护成本证据后再决定是否采用。"
      }
    }
  ]
}
