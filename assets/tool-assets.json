{
  "schema_version": 1,
  "assets": [
    {
      "id": "git-flow-engine",
      "name": "Git Flow Engine",
      "kind": "tool_service",
      "maturity": "verified",
      "version": 1,
      "summary": "受控执行 Branch、Validation、Commit、Issue、Push、PR Review 和 Squash Merge 的确定性状态机。",
      "executor": "builtin:DevelopmentCommitService",
      "actions": ["plan", "execute_local", "execute_remote", "review_pr", "execute_merge"],
      "risk": "high",
      "default_access": "deny",
      "policy_requirements": ["registered_workplace", "versioned_policy", "operator_gate", "snapshot_match"],
      "blueprint": {
        "source": "docs/adr/0004-development-commit-steward.md",
        "notes": "模型负责结构化判断；程序负责固定命令、状态恢复和安全校验。"
      }
    },
    {
      "id": "opencode-correction",
      "name": "OpenCode Correction Runner",
      "kind": "tool_adapter",
      "maturity": "experimental",
      "version": 1,
      "summary": "验证失败后，在批准文件和命令白名单内启动 OpenCode 的受限修复会话。",
      "executor": "binary:opencode",
      "actions": ["correct_code"],
      "risk": "high",
      "default_access": "deny",
      "policy_requirements": ["allow_opencode_fix", "approved_file_scope", "validation_failure"],
      "blueprint": {
        "source": "https://opencode.ai/docs/agents/",
        "notes": "默认拒绝权限；禁止 --auto、外部目录和 Git 远端操作。尚无真实修复 Run 证据。"
      }
    },
    {
      "id": "news-intelligence",
      "name": "News Intelligence Watch",
      "kind": "tool_service",
      "maturity": "experimental",
      "version": 3,
      "summary": "从 HTTPS 白名单信息源收集热点，经情报员评估和确定性去重进入候选池，再由常驻派发器节流推送到 Bark 与 Telegram。",
      "executor": "builtin:IntelligenceService",
      "actions": ["collect", "summarize", "push_bark", "push_telegram"],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["https_source_allowlist", "operator_gate", "secret_isolation", "action_journal"],
      "blueprint": {
        "source": "docs/adr/0009-intelligence-candidate-pipeline.md",
        "notes": "默认每 10 分钟扫描；候选需经过价值阈值与重复门禁，外发至少间隔一分钟且必须幂等、可审计。"
      }
    },
    {
      "id": "internal-bark",
      "name": "Internal Bark Notification Channel",
      "kind": "infrastructure",
      "maturity": "experimental",
      "version": 1,
      "summary": "部落自建的 Bark V2 通知通道，使用独立 device key、健康检查、退避熔断和不透明点击回执。",
      "executor": "builtin:BarkNotificationService + container:ghcr.io/finb/bark-server",
      "actions": ["health_check", "push_notification", "record_open_feedback"],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["secret_isolation", "localhost_or_https", "bounded_retry", "circuit_breaker", "opaque_callback"],
      "blueprint": {
        "source": "docs/internal-bark.md",
        "notes": "服务端自建可移除 api.day.app 依赖，但仍依赖 Apple APNs；Bark 接受不等于用户已打开。"
      }
    },
    {
      "id": "finance-intelligence",
      "name": "Finance Intelligence Watch",
      "kind": "tool_service",
      "maturity": "experimental",
      "version": 1,
      "summary": "以官方披露、监管和宏观数据为证据主干，按市场、自选标的、事件类型与证据等级形成克制的财经候选池。",
      "executor": "builtin:FinanceIntelligenceService",
      "actions": ["collect", "summarize", "push_bark", "push_telegram"],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["official_source_first", "domain_isolation", "no_investment_advice", "secret_isolation", "action_journal"],
      "blueprint": {
        "source": "docs/adr/0017-finance-intelligence-vertical.md",
        "notes": "模型负责事件理解和极简解释；来源白名单、证据等级、去重、阈值与逐目标投递由确定性程序控制。"
      }
    },
    {
      "id": "official-finance-sources",
      "name": "Official Finance Source Registry",
      "kind": "tool_adapter",
      "maturity": "experimental",
      "version": 1,
      "summary": "受控采集巨潮、证监会、人民银行、国家统计局、SEC、美联储和香港金融管理局，并记录逐源健康与缓存证据。",
      "executor": "builtin:FinanceSourceRegistry",
      "actions": ["read_disclosures", "read_regulation", "read_macro", "inspect_source_health"],
      "risk": "low",
      "default_access": "deny",
      "policy_requirements": ["https_source_allowlist", "bounded_fetch", "source_attribution", "cache_age_limit", "original_source_verification"],
      "blueprint": {
        "source": "docs/finance-intelligence.md",
        "notes": "S0/S1 可作为事实证据；商业媒体和行情接口只在取得许可或凭据后启用，社交来源永不单独证明事实。"
      }
    },
    {
      "id": "telegram-bot",
      "name": "Telegram Tribe Bot",
      "kind": "infrastructure",
      "maturity": "experimental",
      "version": 1,
      "summary": "面向白名单群的部落通信通道，支持情报通知、按钮反馈和只读群命令。",
      "executor": "builtin:TelegramBotService",
      "actions": ["health_check", "push_notification", "handle_group_update", "record_feedback"],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["secret_isolation", "chat_allowlist", "webhook_secret", "action_journal", "bounded_commands"],
      "blueprint": {
        "source": "https://core.telegram.org/bots/api",
        "notes": "保持群隐私模式；只处理命令和 Bot 自己发出的按钮回调，不将普通群消息送入模型。"
      }
    },
    {
      "id": "aihot-public-feed",
      "name": "AI HOT Public Feed",
      "kind": "tool_adapter",
      "maturity": "experimental",
      "version": 1,
      "summary": "通过 AI HOT 匿名只读 REST API 获取公开精选，以 fingerprint 控制轮询流量，并保留聚合站与原始信源双重归属。",
      "executor": "builtin:IntelligenceService.collectAiHot",
      "actions": ["read_fingerprint", "read_selected"],
      "risk": "low",
      "default_access": "deny",
      "policy_requirements": ["public_read_only", "identifiable_user_agent", "bounded_polling", "attribution_preserved", "original_source_verification"],
      "blueprint": {
        "source": "https://aihot.virxact.com/agent",
        "notes": "每次巡查先读 fingerprint；变化后才拉 selected items。AI 生成摘要只用于发现和排序，数字、政策、引语与安全事件应回原文复核。"
      }
    },
    {
      "id": "content-studio",
      "name": "Tribe Content Studio",
      "kind": "tool_service",
      "maturity": "experimental",
      "version": 1,
      "summary": "把情报候选转化为可追溯的双人协作内容，提供选题研究、渠道写作、独立审校、不定时调度和复制采纳回执。",
      "executor": "builtin:ContentStudioService",
      "actions": ["research", "write", "review", "schedule", "record_adoption"],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["minimum_two_members", "source_attribution", "independent_review", "operator_gate", "external_publish_gate"],
      "blueprint": {
        "source": "docs/adr/0014-collaborative-content-studio.md",
        "notes": "当前只生成并复制；未来发布适配器必须使用用户上下文授权、显式审批、幂等键和平台回执。"
      }
    },
    {
      "id": "cpa-image-generation",
      "name": "CPA Article Illustration Forge",
      "kind": "tool_adapter",
      "maturity": "experimental",
      "version": 1,
      "summary": "通过本地 CPA 的 Gemini 图片模型生成文章语义配图，执行角色锚定、视觉验收、一次纠错和本地证据留存。",
      "executor": "builtin:CpaIllustrationService",
      "actions": ["brief", "generate_image", "review_image", "retry_once", "persist_artifact"],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["member_assignment", "local_secret_source", "bounded_retry", "image_validation", "human_publish_gate"],
      "blueprint": {
        "source": "docs/adr/0015-cpa-article-illustration.md",
        "notes": "CPA 的 gemini-3.1-flash-image 通过 chat/completions 的 message.images 返回图片；标准 images/generations 端点不适用于该模型。"
      }
    },
    {
      "id": "zvec",
      "name": "Zvec",
      "kind": "infrastructure",
      "maturity": "candidate",
      "version": 1,
      "summary": "候选的开源进程内向量数据库；当前仅作为资产图纸，不自动安装或调用。",
      "executor": "uninstalled",
      "actions": [],
      "risk": "medium",
      "default_access": "deny",
      "policy_requirements": ["evaluation_required"],
      "blueprint": {
        "source": "https://github.com/alibaba/zvec",
        "notes": "需要真实检索任务、资源占用和维护成本证据后再决定是否采用。"
      }
    }
  ]
}
