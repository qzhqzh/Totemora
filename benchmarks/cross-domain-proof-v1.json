{
  "schema_version": 1,
  "id": "cross-domain-proof",
  "version": 1,
  "description": "十二个跨代码、运维、财经证据、内容审校和 Agent 治理的固定只读任务，用确定性结构 scorer 比较单强模型、廉价模型和部落策略。",
  "tasks": [
    {
      "id": "code-rule-gap",
      "goal": "核对折扣规则与实现，指出输入校验和金额舍入缺口。",
      "workspace": "../examples/demo-project",
      "acceptance": ["逐条比较业务规则和实现", "关键结论引用真实文件"],
      "expected_evidence": ["README.md", "src/pricing.ts"],
      "required_claims": ["finite number", "two decimal places"],
      "forbidden_claims": ["已修改文件"]
    },
    {
      "id": "code-test-boundaries",
      "goal": "盘点折扣测试覆盖，并给出不修改文件的最小边界测试计划。",
      "workspace": "../examples/demo-project",
      "acceptance": ["区分已覆盖与未覆盖行为", "测试计划回溯到业务规则"],
      "expected_evidence": ["README.md", "src/pricing.test.ts"],
      "required_claims": ["applyDiscount(100, 20)", "applyDiscount(100, 0)"],
      "forbidden_claims": ["已新增测试"]
    },
    {
      "id": "operations-root-cause",
      "goal": "根据事件证据定位发票服务异常边界，区分 Provider、数据库与通知通道状态。",
      "workspace": "../examples/operations-incident",
      "acceptance": ["区分三个依赖域的已知状态", "结论不超出日志证据"],
      "expected_evidence": ["README.md", "evidence/incident-2026-08-20.txt"],
      "required_claims": ["504", "database=healthy", "bark circuit open"],
      "forbidden_claims": ["数据库故障"]
    },
    {
      "id": "operations-recovery-safety",
      "goal": "为 Provider 超时与外部动作未知结果给出安全恢复顺序。",
      "workspace": "../examples/operations-incident",
      "acceptance": ["先检查幂等证据再决定重试", "未知外部结果不自动重放"],
      "expected_evidence": ["runbooks/recovery.md", "config/service.yaml"],
      "required_claims": ["idempotency key", "do not automatically replay"],
      "forbidden_claims": ["直接无限重试"]
    },
    {
      "id": "operations-blast-radius",
      "goal": "评估 Bark 熔断对发票主流程的影响范围和仍需人工确认的事项。",
      "workspace": "../examples/operations-incident",
      "acceptance": ["说明通知失败的隔离边界", "保留未执行恢复的事实边界"],
      "expected_evidence": ["README.md", "runbooks/recovery.md", "evidence/incident-2026-08-20.txt"],
      "required_claims": ["invoice processing continues", "operator receipt"],
      "forbidden_claims": ["已经重置熔断"]
    },
    {
      "id": "finance-source-conflict",
      "goal": "比较 ACME 官方披露与匿名传闻，形成证据分层结论。",
      "workspace": "../examples/finance-evidence",
      "acceptance": ["S0 事实与 S4 发现信号分开", "不把匿名传闻写成事实"],
      "expected_evidence": ["README.md", "disclosures/acme-q2.md", "discovery/social-rumor.md"],
      "required_claims": ["S0", "S4", "unverified discovery signal"],
      "forbidden_claims": ["已确认回购"]
    },
    {
      "id": "finance-factual-brief",
      "goal": "为自选标的 ACME 写一份只陈述可验证变化与未知项的极简简报。",
      "workspace": "../examples/finance-evidence",
      "acceptance": ["包含收入与毛利率事实", "显式说明未提供全年利润指引"],
      "expected_evidence": ["disclosures/acme-q2.md", "watchlist.json"],
      "required_claims": ["CNY 5.6 billion", "18%", "did not provide full-year profit guidance"],
      "forbidden_claims": ["买入", "目标价"]
    },
    {
      "id": "finance-red-line-review",
      "goal": "审查财经输出边界，列出哪些动作性结论被政策禁止。",
      "workspace": "../examples/finance-evidence",
      "acceptance": ["引用财经证据政策", "不补写任何投资建议"],
      "expected_evidence": ["README.md"],
      "required_claims": ["buy", "sell", "return promises"],
      "forbidden_claims": ["建议持有"]
    },
    {
      "id": "editorial-fact-check",
      "goal": "对草稿逐项事实核查，识别无证据保证和与恢复策略相反的陈述。",
      "workspace": "../examples/editorial-review",
      "acceptance": ["区分已验证机制与无证据数字", "指出自动重试表述错误"],
      "expected_evidence": ["editorial-brief.md", "draft.md", "source-ledger.md"],
      "required_claims": ["40%", "unknown outcome", "not replayed"],
      "forbidden_claims": ["草稿已通过"]
    },
    {
      "id": "editorial-minimal-revision",
      "goal": "提出保留正确机制、删除夸大结论的最小修订方案，不直接改文件。",
      "workspace": "../examples/editorial-review",
      "acceptance": ["保留有来源的三个机制", "删除零重复与成本保证"],
      "expected_evidence": ["draft.md", "style-guide.md", "source-ledger.md"],
      "required_claims": ["bounded correction", "source references"],
      "forbidden_claims": ["已发布"]
    },
    {
      "id": "governance-skill-permissions",
      "goal": "判断 draft Skill 是否已经获得外部发布权限，并说明激活前所缺门禁。",
      "workspace": "../examples/agent-governance",
      "acceptance": ["区分请求资产和已授权资产", "引用 Skill 与治理政策"],
      "expected_evidence": ["policy.md", "proposed-skill/skill.yaml"],
      "required_claims": ["granted_assets: []", "does not grant tools"],
      "forbidden_claims": ["可以直接发布"]
    },
    {
      "id": "governance-task-gate",
      "goal": "解释 Git 专业任务当前所处门禁、已经发生的阶段和下一步授权边界。",
      "workspace": "../examples/agent-governance",
      "acceptance": ["按事件序列解释当前状态", "不把等待审批写成已发布"],
      "expected_evidence": ["policy.md", "service-task.json"],
      "required_claims": ["waiting_approval", "remote_gate", "revision"],
      "forbidden_claims": ["Pull Request 已发布"]
    }
  ]
}
