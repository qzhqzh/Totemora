# Provider API keys
OPENAI_API_KEY=

# Local runtime paths
TOTEMORA_CONFIG_DIR=./configs/example
TOTEMORA_DATA_DIR=./.totemora
TOTEMORA_HOST=127.0.0.1
TOTEMORA_PORT=4310
# Optional override. When empty, Gateway creates .totemora/operator-token with mode 0600.
TOTEMORA_OPERATOR_TOKEN=
# Self-hosted Bark V2. Prefer the matching files under .totemora/secrets/ with mode 0600.
# The legacy full push URL remains supported for migration only.
TOTEMORA_BARK_SERVER_URL=http://127.0.0.1:18080
TOTEMORA_BARK_DEVICE_KEY=
TOTEMORA_BARK_BASIC_AUTH_USER=
TOTEMORA_BARK_BASIC_AUTH_PASSWORD=
# Emergency compatibility only. Internal Bark remains the default and does not
# silently fall back to api.day.app.
TOTEMORA_BARK_ALLOW_LEGACY=false
TOTEMORA_BARK_BASE_URL=
# Public/LAN/Tailscale URL that a phone can reach. When set, Bark clicks record a
# weak positive signal at /r/<opaque-token> and then redirect to the original item.
TOTEMORA_PUBLIC_BASE_URL=
# Optional comma-separated HTTPS feeds; runtime still enforces the source host allowlist.
TOTEMORA_NEWS_FEEDS=
# Optional social trend credentials. Prefer .totemora/secrets/x-bearer-token and
# .totemora/secrets/weibo-access-token (0600) instead of environment variables.
TOTEMORA_X_BEARER_TOKEN=
TOTEMORA_WEIBO_ACCESS_TOKEN=
